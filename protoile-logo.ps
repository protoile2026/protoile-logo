q 0 0 811 811 rectclip
1 0 0 -1 0 811 cm q
1 g
0 0 811 811 rectfill
Q q
0 0 810 810 re W n
q
0 0 810 810 re W n
[ 810.000388 0 0 -810.000388 0.0000035 810.000408 ] concat
/cairo_ascii85_file currentfile /ASCII85Decode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Width 2048
  /Height 2048
  /BitsPerComponent 8
  /Interpolate true
  /Decode [ 0 1 0 1 0 1 ]
  /DataSource cairo_ascii85_file /DCTDecode filter
  /ImageMatrix [ 2048 0 0 -2048 0 2048 ]
>>
